{
  "appId": "com.vibegram.app",
  "appName": "Instagram 2.0",
  "webDir": "client/dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "providers": [
        "google.com"
      ],
      "skipNativeAuth": false
    }
  }
}